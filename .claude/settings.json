{
  "enabledPlugins": {
    "databricks@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(~/.databrickscfg)",
      "Bash(databricks bundle deploy:*)",
      "Bash(databricks bundle destroy:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  }
}